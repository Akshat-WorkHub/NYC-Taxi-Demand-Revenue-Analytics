	column YearMonthSort = YEAR(Dim_Date[Date]) * 100 + MONTH(Dim_Date[Date])
		formatString: 0
		lineageTag: f61cffe9-9e6c-42e5-8d2b-8d11e3ba3450
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = calculated
		mode: import
		source =
				
				VAR StartDate = DATE(2024, 1, 1)
				VAR EndDate = DATE(2026, 7, 31)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(StartDate, EndDate),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Year Month", FORMAT([Date], "YYYY-MM"),
				    "Day", DAY([Date]),
				    "Day of Week Number", WEEKDAY([Date], 2),
				    "Day Name", FORMAT([Date], "dddd"),
				    "Week Number", WEEKNUM([Date], 2),
				    "Is Weekend", WEEKDAY([Date], 2) >= 6
				)

	annotation PBI_Id = 4a6ac5f601204183a63546bec33a7f9e

