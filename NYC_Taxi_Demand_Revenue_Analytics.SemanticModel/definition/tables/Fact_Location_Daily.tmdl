table Fact_Location_Daily
	lineageTag: af5f2634-9d2b-4f06-83f8-387e66a65296

	measure 'Pickup Trips' = SUM(Fact_Location_Daily[total_trips])
		formatString: #,0
		lineageTag: 06f3f438-bd6d-4632-804f-07f08f670bf0

	measure 'Pickup Revenue' = SUM(Fact_Location_Daily[total_revenue])
		formatString: $#,0.00
		lineageTag: 208c6389-8e4e-41b6-a486-4c78ed00b31c

	measure 'Manhattan Pickup Trip Share' = DIVIDE(CALCULATE([Pickup Trips], REMOVEFILTERS(Dim_Pickup_Location), Dim_Pickup_Location[Borough] = "Manhattan"), CALCULATE([Pickup Trips], REMOVEFILTERS(Dim_Pickup_Location)))
		formatString: 0.0%
		lineageTag: aa21baac-e0df-4a21-8c37-46f7485bd42c

	measure 'Active Pickup Locations' = DISTINCTCOUNT(Fact_Location_Daily[pickup_location_id])
		formatString: #,0
		lineageTag: c570877a-c81a-4d7c-b7bf-93e9483ce2c4

	/// Pickup Trips as a share of pickup trips across all pickup zones in the current date/taxi context.
	measure 'Pickup Trip Share' = DIVIDE([Pickup Trips], CALCULATE([Pickup Trips], REMOVEFILTERS(Dim_Pickup_Location)))
		formatString: 0.0%
		lineageTag: e630b64c-47de-40df-9b46-e15c6f9dce11

