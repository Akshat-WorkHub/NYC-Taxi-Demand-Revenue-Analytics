table Fact_Payment_Daily
	lineageTag: 3357e996-e5f0-429e-b65d-42c24147ed9e

	measure 'Payment Trips' = SUM(Fact_Payment_Daily[total_trips])
		formatString: #,0
		lineageTag: 52c4d550-afce-4f91-ad9c-865e1b926b73

	measure 'Payment Revenue' = SUM(Fact_Payment_Daily[total_revenue])
		formatString: $#,0.00
		lineageTag: 1ee8d9c0-025b-4050-914c-05ce1af3ead1

	measure 'Payment Tips' = SUM(Fact_Payment_Daily[total_tips])
		formatString: $#,0.00
		lineageTag: 00d30595-269d-4963-943b-a05d65d50d30

	measure 'Average Payment Tip' = DIVIDE(SUM(Fact_Payment_Daily[total_tips]), SUM(Fact_Payment_Daily[tip_count]))
		formatString: $0.00
		lineageTag: 77de7489-8ae2-4362-916e-358902b984ec

	/// Payment Revenue as a share of payment revenue across all payment methods in the current date/taxi context.
	measure 'Payment Revenue Share' = DIVIDE([Payment Revenue], CALCULATE([Payment Revenue], REMOVEFILTERS(Dim_Payment)))
		formatString: 0.0%
		lineageTag: cabf8db4-32ab-4adc-9edb-9b1c139f7150

